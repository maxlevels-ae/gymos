    "marketing.campaigns.manage",
    "marketing.automations.manage",
    "marketing.logs.view",
    "marketing.settings.manage",
    "marketing.send"
  ],
  "menu": [
    {
      "label": "Marketing",
      "labelAr": "التسويق",
