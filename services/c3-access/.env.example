# ── Panel (ZKTeco C3-100) ──
C3_HOST=192.168.1.201        # panel LAN IP (set via discover.py --set-ip)
C3_PORT=4370                 # ZKAccess TCP port (default 4370)
C3_PASSWORD=                 # comm password (blank = none, as shipped)
C3_DOOR_NO=1                 # door number to control (C3-100 = 1)
C3_OPEN_SECONDS=5            # default remote-open relay duration

# ── Watchdog / reconnect ──
C3_CONNECT_TIMEOUT=5         # seconds
C3_RETRY_BASE=1              # exponential backoff base (s): 1,2,4,8… capped
C3_RETRY_MAX=30             # backoff cap (s)
C3_WATCHDOG_INTERVAL=10      # health ping period (s)
C3_RTLOG_POLL_MS=800         # real-time log poll interval for /events/stream

# ── Token (QR) issuance / validation ──
# Shared HMAC secret. MUST match the value the GymOS app uses to mint QR tokens.
TOKEN_SECRET=change-me-shared-with-erp
TOKEN_WINDOW_SECONDS=30      # rotation window
TOKEN_SKEW_WINDOWS=1         # accept current ±N windows (clock skew tolerance)

# ── Service auth (protect the REST API on the LAN) ──
SERVICE_API_KEY=change-me-service-key   # required in X-API-Key header

# ── Optional: push scan events to the ERP (its own auth handled ERP-side) ──
ERP_WEBHOOK_URL=            # e.g. http://gymos:3000/api/access/c3-event
ERP_WEBHOOK_KEY=
