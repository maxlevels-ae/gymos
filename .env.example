# ── Server ──────────────────────────────────────
PORT=3000
APP_PORT=3000
NODE_ENV=production
CPANEL_ENV=true
TRUST_PROXY=true

# ── Database ────────────────────────────────────
DB_PATH=./data/gym.db
DB_BACKUP_DIR=./data/backups
DB_SAVE_INTERVAL=2000
DB_WAL_MODE=true

# ── Security (REQUIRED in production) ──────────
JWT_SECRET=generate-with-openssl-rand-hex-64
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
PWA_JWT_EXPIRES_IN=12h
PWA_JWT_REFRESH_EXPIRES_IN=90d
CORS_ORIGINS=https://yourdomain.com
FORCE_ADMIN_PW_CHANGE=true

# ── Rate Limiting ──────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOGIN_WINDOW_MS=900000
OTP_MAX_ATTEMPTS=3
OTP_SEND_LIMIT=5

# ── Performance ────────────────────────────────
COMPRESSION=true
JSON_LIMIT=10mb
QUERY_MAX_LIMIT=100

# ── App ────────────────────────────────────────
APP_NAME=GymOS
APP_LOCALE=en
APP_DIR=ltr
MODULES_PATH=./modules
UPLOADS_PATH=./data/uploads
LOG_LEVEL=info
