# cPanel shared-hosting example
PORT=3000
APP_PORT=3000
NODE_ENV=production
CPANEL_ENV=true
TRUST_PROXY=true

APP_NAME=GymOS
APP_LOCALE=ar
APP_DIR=auto

DB_PATH=./data/gym.db
DB_BACKUP_DIR=./data/backups
DB_SAVE_INTERVAL=2000
DB_WAL_MODE=false

JWT_SECRET=replace_with_long_random_secret
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
PWA_JWT_EXPIRES_IN=12h
PWA_JWT_REFRESH_EXPIRES_IN=90d

# Use your real domain here
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

FORCE_ADMIN_PW_CHANGE=true
MAX_LOGIN_ATTEMPTS=5
LOGIN_WINDOW_MS=900000
OTP_MAX_ATTEMPTS=3
OTP_SEND_LIMIT=5
COMPRESSION=true
JSON_LIMIT=10mb
QUERY_MAX_LIMIT=100
MODULES_PATH=./modules
UPLOADS_PATH=./data/uploads
LOG_LEVEL=info
